<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0A0C12">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3W影视"
            android:textColor="#F5F7FA"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="多源 · 高清 · 本地 · 下载"
            android:textColor="#A0A8B6"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="#14171F"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="搜索影片、电视剧、动漫……"
                android:textColorHint="#6E7684"
                android:singleLine="true"
                android:textColor="#F5F7FA"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="72dp"
                android:layout_height="46dp"
                android:background="#37B4FF"
                android:gravity="center"
                android:text="搜索"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="快捷入口"
            android:textColor="#F5F7FA"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/quickActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quickSearch"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:background="#14171F"
                android:gravity="center"
                android:text="🔎&#10;搜索"
                android:textColor="#F5F7FA"
                android:textSize="13sp" />

            <Space
                android:layout_width="7dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/quickLocal"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:background="#14171F"
                android:gravity="center"
                android:text="▶&#10;本地"
                android:textColor="#F5F7FA"
                android:textSize="13sp" />

            <Space
                android:layout_width="7dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/quickHistory"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:background="#14171F"
                android:gravity="center"
                android:text="◷&#10;历史"
                android:textColor="#F5F7FA"
                android:textSize="13sp" />

            <Space
                android:layout_width="7dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/quickFavorite"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:background="#14171F"
                android:gravity="center"
                android:text="★&#10;收藏"
                android:textColor="#F5F7FA"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="我的影视"
            android:textColor="#F5F7FA"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuDownload"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:background="#14171F"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="↓   下载管理&#10;      管理正在下载、已暂停和已完成的视频"
            android:textColor="#F5F7FA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/menuSource"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="5dp"
            android:background="#14171F"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="◈   视频源&#10;      管理 API 来源、启用状态、优先级和默认来源"
            android:textColor="#F5F7FA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/menuSubscription"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="5dp"
            android:background="#14171F"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="↻   订阅管理&#10;      导入 TXT / JSON / M3U 等订阅并提取视频源"
            android:textColor="#F5F7FA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/menuLocal"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="5dp"
            android:background="#14171F"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="▣   本地视频&#10;      添加多个本地文件夹，直接读取原始视频"
            android:textColor="#F5F7FA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/menuHistory"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="5dp"
            android:background="#14171F"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="◷   观看历史&#10;      继续观看最近播放的影片和剧集"
            android:textColor="#F5F7FA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/menuFavorite"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="5dp"
            android:background="#14171F"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="★   我的收藏&#10;      快速找到收藏的影片"
            android:textColor="#F5F7FA"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="系统"
            android:textColor="#F5F7FA"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:background="#14171F"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="⚙   播放器设置&#10;      倍速、画面比例、时钟、缓存和下载设置"
            android:textColor="#F5F7FA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="16dp"
            android:text="3W影视  ·  1.0.0"
            android:textColor="#6E7684"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
