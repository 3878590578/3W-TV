<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#33000000">

    <!-- 顶部栏 -->
    <RelativeLayout
        android:id="@+id/top_bar_3w"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="16dp"
        android:background="#66000000">

        <TextView
            android:id="@+id/tv_title_3w"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="3W本地播放"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/tv_system_time_3w"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:format12Hour="HH:mm:ss"
            android:format24Hour="HH:mm:ss"
            android:textColor="#DDDDDD"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- 播放/暂停按键 -->
    <ImageButton
        android:id="@id/exo_play_pause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_centerInParent="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_media_play" />

    <!-- 底部控制栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#66000000"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/tv_tag_exo_3w"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/tv_tag_hw_3w"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="硬解"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/btn_speed_3w"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.00"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/tv_skip_info_3w"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跳过片头:0s | 片尾:99s"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>