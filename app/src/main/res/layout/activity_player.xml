<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true"
        android:use_controller="true"
        android:controller_show_timeout="3000" />

    <View
        android:id="@+id/gestureArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/playerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="15dp"
        android:maxWidth="420dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="本地视频"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:background="#66000000"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/beijingTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="18dp"
        android:text="00:00:00"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:background="#66000000"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="65dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/favoriteButton"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:text="☆"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:onClick="toggleFavorite" />

        <Button
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:text="倍速"
            android:textColor="#FFFFFF"
            android:onClick="changeSpeed" />

        <Button
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:text="音轨"
            android:textColor="#FFFFFF"
            android:onClick="selectAudio" />

        <Button
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:text="字幕"
            android:textColor="#FFFFFF"
            android:onClick="selectSubtitle" />

    </LinearLayout>

    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="亮度"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:background="#AA000000"
        android:visibility="gone" />

</FrameLayout>